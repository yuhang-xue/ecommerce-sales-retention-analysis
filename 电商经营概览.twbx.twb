      <aliases enabled='yes' />
      <column caption='客单价' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2552719228059648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([OrderKey]) &gt; 0 THEN&#10;    SUM([LineAmount]) / COUNTD([OrderKey])&#10;END' />
      </column>
      <column caption='金额明细提示' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2552719229714433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([LineAmount])' />
      </column>
      <column caption='商品名称提示' datatype='string' name='[Calculation_2552719231754242]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN([Description])' />
      </column>
      <column caption='最高月份高亮' datatype='string' name='[Calculation_2552719290761219]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([LineAmount]) = WINDOW_MAX(SUM([LineAmount]))&#10;THEN &quot;最高月份&quot;&#10;ELSE &quot;其他月份&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='最高月份金额' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Calculation_2552719291731972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([LineAmount]) = WINDOW_MAX(SUM([LineAmount]))&#10;THEN SUM([LineAmount])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='新老客金额占比' datatype='real' default-format='p0.0%' name='[Calculation_2552719292768262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([LineAmount]) / WINDOW_SUM(SUM([LineAmount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='商品排名高亮' datatype='string' name='[Calculation_2552719576678408]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_DENSE(SUM([LineAmount]), &apos;desc&apos;) = 1&#10;THEN &quot;第一名&quot;&#10;ELSE &quot;其他商品&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
